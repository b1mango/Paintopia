PAINTOPIA_HOST=127.0.0.1
PAINTOPIA_API_PORT=8787
PAINTOPIA_WEB_ORIGIN=http://localhost:5173
PAINTOPIA_DATA_DIR=./data
PAINTOPIA_BOOTSTRAP_EMAIL=admin
# Only this account keeps personal images permanently; defaults to the bootstrap account.
PAINTOPIA_OWNER_EMAIL=admin
PAINTOPIA_BOOTSTRAP_PASSWORD=change-me-local-password
PAINTOPIA_INVITE_CODE=change-me-local-invite-code
PAINTOPIA_SESSION_SECRET=replace-with-a-local-random-string

# Production database and provider-secret encryption.
DATABASE_URL=
PAINTOPIA_PROVIDER_ENCRYPTION_KEY=

# Cloudflare R2. Keep the bucket private.
PAINTOPIA_R2_ACCOUNT_ID=
PAINTOPIA_R2_ACCESS_KEY_ID=
PAINTOPIA_R2_SECRET_ACCESS_KEY=
PAINTOPIA_R2_BUCKET=paintopia-assets
PAINTOPIA_ASSET_RETENTION_DAYS=7
PAINTOPIA_PENDING_GALLERY_RETENTION_DAYS=30
CRON_SECRET=

# Optional additions to the built-in high-risk content blocklist. Separate with commas or new lines.
PAINTOPIA_PROHIBITED_TERMS=

# Optional OpenAI-compatible text provider for prompt translation/optimization.
# NewAPI, Sub2API, CCSwitch and similar gateways usually expose an OpenAI-compatible /v1 base URL.
PAINTOPIA_DEFAULT_TEXT_PROVIDER_NAME=GPT-5 Nano
PAINTOPIA_DEFAULT_TEXT_BASE_URL=
PAINTOPIA_DEFAULT_TEXT_MODEL=gpt-5-nano
PAINTOPIA_DEFAULT_TEXT_MODE=chat_completions
PAINTOPIA_DEFAULT_TEXT_API_KEY=

# Optional authenticated thumbnail edge cache (same secret in Worker).
PAINTOPIA_MEDIA_EDGE_URL=
PAINTOPIA_MEDIA_SIGNING_KEY=
