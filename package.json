{
  "name": "paintopia",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm-run-all --parallel dev:web dev:api",
    "dev:web": "npm --workspace @paintopia/web run dev",
    "dev:api": "npm --workspace @paintopia/api run dev",
    "build": "npm-run-all build:shared build:api build:web",
    "build:shared": "npm --workspace @paintopia/shared run build",
    "build:api": "npm --workspace @paintopia/api run build",
    "build:web": "npm --workspace @paintopia/web run build",
    "test": "npm-run-all test:shared test:api test:web",
    "test:shared": "npm --workspace @paintopia/shared run test",
    "test:api": "npm --workspace @paintopia/api run test",
    "test:web": "npm --workspace @paintopia/web run test",
    "typecheck": "npm-run-all typecheck:shared typecheck:api typecheck:web typecheck:scripts",
    "typecheck:shared": "npm --workspace @paintopia/shared run typecheck",
    "typecheck:api": "npm --workspace @paintopia/api run typecheck",
    "typecheck:web": "npm --workspace @paintopia/web run typecheck",
    "typecheck:scripts": "tsc -p scripts/tsconfig.json",
    "migrate:production": "node --use-env-proxy --import tsx scripts/migrate-production-data.ts",
    "sync:production-to-local": "node --use-env-proxy --import tsx scripts/sync-production-to-local.ts --confirm-replace-local"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "esbuild": "^0.28.2"
  }
}
